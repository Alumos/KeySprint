KEYSPRINT_IMAGE=ghcr.io/alumos/keysprint
KEYSPRINT_TAG=1.1.0
KEYSPRINT_PORT=8081
DATA_VOLUME_NAME=keysprint_data
TZ=Asia/Shanghai

# 使用 openssl rand -hex 32 生成；不要与下方的系统间共享密钥复用。
JWT_SECRET=replace-with-a-long-random-secret

# ClassOrbit 已在同一台 VPS 的宿主机 8080 端口运行。
CLASS_SOURCE=classorbit
CLASS_SYSTEM_URL=http://host.docker.internal:8080
CLASS_SYSTEM_PATH=/api/integration/classes
# 必须与 ClassOrbit 部署配置中的 CLASS_SYSTEM_TOKEN 完全一致。
CLASS_SYSTEM_TOKEN=replace-with-the-classorbit-shared-token
CLASS_SYSTEM_TIMEOUT=8s
