# 本文件是 config.env 的示例，复制为 config.env 后生效。
# 第一次运行 start.bat 时会自动生成 config.env，通常无需手工创建。

# 教师登录令牌的签名密钥：随机字符串，修改后所有教师需要重新登录。
JWT_SECRET=请替换为随机字符串

# 监听端口；修改后要同步修改 allow-firewall.bat 里的 PORT 并重新放行。
ADDR=:8080

# 数据库位置，默认在包目录 data\keysprint.db。
# DB_PATH=D:\KeySprint\data\keysprint.db

# 前端静态文件目录，默认在包目录 web\。
# PUBLIC_DIR=D:\KeySprint\web

# 时区，用于比赛时间显示。
TZ=Asia/Shanghai
