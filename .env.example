KEYSPRINT_IMAGE=ghcr.io/alumos/keysprint
KEYSPRINT_TAG=latest
DATA_VOLUME_NAME=keysprint_data
PORT=8080
TZ=Asia/Shanghai
# 使用 openssl rand -hex 32 生成，部署后不要随意修改，否则现有登录会失效。
JWT_SECRET=replace-with-a-long-random-secret
# 班级名单主要来源：manual（Excel 手工导入）或 classorbit（接口同步）。
CLASS_SOURCE=manual
# ClassOrbit 教师班级接口。KeySprint 会用当前登录教师的用户名请求。
CLASS_SYSTEM_URL=
CLASS_SYSTEM_PATH=/api/integration/classes
# 必须与 ClassOrbit 的 CLASS_SYSTEM_TOKEN 完全一致。
CLASS_SYSTEM_TOKEN=
CLASS_SYSTEM_TIMEOUT=8s
