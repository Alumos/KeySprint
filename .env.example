PORT=8080
TZ=Asia/Shanghai
# 使用 openssl rand -hex 32 生成，部署后不要随意修改，否则现有登录会失效。
JWT_SECRET=replace-with-a-long-random-secret
# 可选：班级积分系统的教师班级接口。KeySprint 会用当前登录教师的用户名请求。
CLASS_SYSTEM_URL=
CLASS_SYSTEM_PATH=/api/integration/classes
# 与班级积分系统约定的服务端共享密钥，不填则不发送 Authorization。
CLASS_SYSTEM_TOKEN=
CLASS_SYSTEM_TIMEOUT=8s
# 国内服务器构建加速；海外服务器可改为官方源或留空使用 Dockerfile 默认值
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
