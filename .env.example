KEYSPRINT_IMAGE=ghcr.io/alumos/keysprint
KEYSPRINT_TAG=latest
DATA_VOLUME_NAME=keysprint_data
PORT=8080
TZ=Asia/Shanghai
# 使用 openssl rand -hex 32 生成，部署后不要随意修改，否则现有登录会失效。
JWT_SECRET=replace-with-a-long-random-secret
# 可选：班级积分系统的教师班级接口。KeySprint 会用当前登录教师的用户名请求。
CLASS_SYSTEM_URL=
CLASS_SYSTEM_PATH=/api/integration/classes
# 与班级积分系统约定的服务端共享密钥，不填则不发送 Authorization。
CLASS_SYSTEM_TOKEN=
CLASS_SYSTEM_TIMEOUT=8s
